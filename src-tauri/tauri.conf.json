{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarkov Mappinator",
  "version": "0.1.0",
  "identifier": "local.tarkov-mappinator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tarkov Mappinator",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#121314",
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost tiles: http://tiles.localhost thumb: http://thumb.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
